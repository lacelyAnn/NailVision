# Set these in Vercel (Project Settings > Environment Variables). Never commit real values.
VITE_SD_URL=https://your-service.onrender.com
# Optional, matches API_TOKEN on the server. Visible in the browser bundle, so not a real secret.
VITE_SD_TOKEN=
# Supabase > Project Settings > API. The anon key is public; Row Level Security protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
