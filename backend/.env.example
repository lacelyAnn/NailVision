# Copy these into the Render service's Environment tab (or, for local runs, into backend/.env). Never commit real values.
ALLOWED_ORIGINS=https://your-app.vercel.app   # comma-separated; defaults to * (open) if unset
API_TOKEN=                                     # optional; must match VITE_SD_TOKEN
MODEL_DIR=                                     # local model folder, only for GEN_BACKEND=local; default models/sd15-inpainting
GEN_BACKEND=replicate                          # replicate (default) or local (SD 1.5 on this machine)
GEN_FALLBACK_LOCAL=false                       # true = local pipeline when Replicate fails (needs requirements-local.txt)
REPLICATE_API_TOKEN=                           # replicate.com > Account settings > API tokens (starts with r8_). Server only, never in the app
REPLICATE_MODEL_VERSION=                       # optional; default is stability-ai/stable-diffusion-inpainting 95b72231...
MOCK=                                          # set to 1 to skip Stable Diffusion (fast fake output)
