# Copy these into the Render service's Environment tab (or, for local runs, into backend/.env.local). Never commit real values.
ALLOWED_ORIGINS=https://your-app.vercel.app   # comma-separated; defaults to * (open) if unset
API_TOKEN=                                     # optional; must match VITE_SD_TOKEN
MODEL_DIR=                                     # local model folder, only for GEN_BACKEND=local; default models/sd15-inpainting
GEN_BACKEND=cloudflare                         # cloudflare (default) or local (SD 1.5 on this machine)
GEN_FALLBACK_LOCAL=false                       # true = local pipeline when Cloudflare fails (needs requirements-local.txt)
CF_ACCOUNT_ID=                                 # Cloudflare dashboard > Workers & Pages > Account ID
CF_API_TOKEN=                                  # API token from the "Workers AI" template. Server only, never in the app
MOCK=                                          # set to 1 to skip Stable Diffusion (fast fake output)
