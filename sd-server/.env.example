# Copy these into the Render service's Environment tab (or set in PowerShell for local runs). Never commit real values.
ALLOWED_ORIGINS=https://your-app.vercel.app   # comma-separated; defaults to * (open) if unset
API_TOKEN=                                     # optional; must match VITE_SD_TOKEN
MODEL_DIR=/models/sd15-inpainting              # set by the Dockerfile; override locally to ../gpu/sd15-inpainting
MOCK=                                          # set to 1 to skip Stable Diffusion (fast fake output)
